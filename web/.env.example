# Torus server (see server/README) — powers /stats and /quote on the dashboard.
NEXT_PUBLIC_SERVER_URL=http://localhost:8787

# Defaults to the live Arc Testnet deployment (contracts/deployments/5042002.json) if unset.
# If your browser/extensions (e.g. Brave Shields, an ad blocker) block the primary RPC
# domain, try one of the alternates — all verified to serve permissive CORS headers:
# NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io
# NEXT_PUBLIC_ARC_RPC_URL=https://rpc.blockdaemon.testnet.arc.io
# NEXT_PUBLIC_ARC_RPC_URL=https://rpc.drpc.testnet.arc.io
# NEXT_PUBLIC_ARC_RPC_URL=https://rpc.quicknode.testnet.arc.io
# NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# NEXT_PUBLIC_VAULT_ADDRESS=0xF87e393cdC523E69dE27e2E992225136d654273b
# NEXT_PUBLIC_PAYMASTER_ADDRESS=0x497B7b6aAcB8a3372D569740c92ED53F75ED670B

# The EIP-7702 gasless demo (Privy embedded wallet + a bundler) lives separately, as a
# standalone third-party-integration example — see examples/gasless-demo/web.
