# The web app supports Arc Testnet and Arc Mainnet at the same time — see the network switch
# next to the account menu. Both networks' addresses are hardcoded defaults in
# src/lib/networks.ts (same pattern as before); every var below only overrides one of them and
# is optional. NEXT_PUBLIC_ARC_NETWORK only picks which one loads first per browser (the user's
# own toggle, persisted to localStorage, wins after that).
# NEXT_PUBLIC_ARC_NETWORK=testnet

# --- Testnet (chain 5042002) ---

# Torus server instance serving testnet (`bun run start` in server/, port 8787 by default).
# NEXT_PUBLIC_SERVER_URL_TESTNET=http://localhost:8787

# If your browser/extensions (e.g. Brave Shields, an ad blocker) block the primary RPC
# domain, try one of the alternates — all verified to serve permissive CORS headers:
# NEXT_PUBLIC_ARC_RPC_URL_TESTNET=https://rpc.testnet.arc.io
# NEXT_PUBLIC_ARC_RPC_URL_TESTNET=https://rpc.blockdaemon.testnet.arc.io
# NEXT_PUBLIC_ARC_RPC_URL_TESTNET=https://rpc.drpc.testnet.arc.io
# NEXT_PUBLIC_ARC_RPC_URL_TESTNET=https://rpc.quicknode.testnet.arc.io

# Defaults to the live testnet deployment (contracts/deployments/5042002.json) if unset.
# NEXT_PUBLIC_VAULT_ADDRESS_TESTNET=0xF87e393cdC523E69dE27e2E992225136d654273b
# NEXT_PUBLIC_PAYMASTER_ADDRESS_TESTNET=0x497B7b6aAcB8a3372D569740c92ED53F75ED670B
# NEXT_PUBLIC_PAYMASTER_V08_ADDRESS_TESTNET=0xA49e84E73aE841DAc8A80CfD8fB11BD09a8B17AC
# Already deployed on Arc Testnet; override only if you deploy your own copy of
# examples/gasless-demo/contracts/src/ExampleCounter.sol.
# NEXT_PUBLIC_COUNTER_ADDRESS_TESTNET=0x7d2b774D9cdBB6f3c69AC7be97E633fA911b8e66

# A bundler that supports Arc Testnet + EIP-7702 (e.g. Pimlico: https://dashboard.pimlico.io).
# NEXT_PUBLIC_BUNDLER_URL_TESTNET=https://api.pimlico.io/v2/5042002/rpc?apikey=YOUR_KEY

# --- Mainnet (chain 5042) ---

# Torus server instance serving mainnet (`bun run start:mainnet` in server/, port 8788 by default).
# NEXT_PUBLIC_SERVER_URL_MAINNET=http://localhost:8788

# NEXT_PUBLIC_ARC_RPC_URL_MAINNET=https://rpc.mainnet.arc.io

# Defaults to the live mainnet deployment (contracts/deployments/5042.json) if unset.
# NEXT_PUBLIC_VAULT_ADDRESS_MAINNET=0xF87e393cdC523E69dE27e2E992225136d654273b
# NEXT_PUBLIC_PAYMASTER_ADDRESS_MAINNET=0x497B7b6aAcB8a3372D569740c92ED53F75ED670B
# NEXT_PUBLIC_PAYMASTER_V08_ADDRESS_MAINNET=0x4Eaf8e9c74DeC33e7D4c71ED81B8CD3A6687A2dF
# NEXT_PUBLIC_COUNTER_ADDRESS_MAINNET=0x230bcd175ce42E1B1eA0dd4B5a488DAEae59e346

# A bundler that supports Arc Mainnet + EIP-7702 (e.g. Pimlico: https://dashboard.pimlico.io).
# NEXT_PUBLIC_BUNDLER_URL_MAINNET=https://api.pimlico.io/v2/5042/rpc?apikey=YOUR_KEY

# --- Shared ---

# Powers the /gasless demo (EIP-7702 via a Privy embedded wallet) — proves a completely
# unrelated third-party contract (ExampleCounter, see examples/gasless-demo/contracts) can be
# called gaslessly through Torus's own paymaster endpoint. Same Privy app works for both
# networks — enable both Arc Testnet (5042002) and Arc (5042) as supported/embedded-wallet
# chains at https://dashboard.privy.io, and enable embedded wallets under
# Wallet Infrastructure > Embedded Wallets.
# NEXT_PUBLIC_PRIVY_APP_ID=
