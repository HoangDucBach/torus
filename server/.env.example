# NODE_ENV picks which of .env.development / .env.production Bun loads (see those files for
# ARC_NETWORK/PORT). This file holds vars shared by both.

# ARC_RPC_URL=https://rpc.testnet.arc.io
# DEPLOYMENT_FILE=../contracts/deployments/5042002.json

# Indexer state (server/src/indexer.ts) — rows are keyed by chain id, so testnet and mainnet
# can share one instance/database. `docker compose up postgres` starts a local one.
DATABASE_URL=postgres://torus:torus@localhost:5432/torus

KEEPER_PRIVATE_KEY=0x
KEEPER_INTERVAL_SECONDS=3600
PAYMASTER_MIN_DEPOSIT_WEI=1000000000000000000
