# Which Arc network to target: "testnet" (5042002) or "mainnet" (5042).
ARC_NETWORK=testnet

# Overrides the default RPC picked from ARC_NETWORK (docs.arc.io/arc/references/connect-to-arc).
# ARC_RPC_URL=https://rpc.testnet.arc.io

# Path to the deployment file written by contracts/script/Deploy.s.sol.
# Defaults to ../contracts/deployments/<chainId>.json
# DEPLOYMENT_FILE=../contracts/deployments/5042002.json

# Private key for the keeper account. Only needs to be funded with a little native USDC to pay
# gas for accrue()/harvest()/refuel() calls — none of them require special privileges.
KEEPER_PRIVATE_KEY=0x

# How often the keeper runs its accrue -> harvest -> refuel cycle, in seconds.
KEEPER_INTERVAL_SECONDS=3600

# Below this EntryPoint deposit balance (in native wei), the keeper prioritizes refuel().
PAYMASTER_MIN_DEPOSIT_WEI=1000000000000000000

PORT=8787
