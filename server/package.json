{
  "name": "torus-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun run --watch src/index.ts",
    "start": "NODE_ENV=development bun run src/index.ts",
    "dev:production": "NODE_ENV=production bun run --watch src/index.ts",
    "start:production": "NODE_ENV=production bun run src/index.ts",
    "keeper": "NODE_ENV=development bun run src/keeper.ts",
    "keeper:production": "NODE_ENV=production bun run src/keeper.ts",
    "e2e": "bun run scripts/e2e.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.8",
    "viem": "^2.56.8",
    "permissionless": "^0.4.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.7.0"
  }
}
