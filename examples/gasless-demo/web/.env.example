# Torus's server — this demo only calls its ERC-7677 paymaster RPC (POST /paymaster).
NEXT_PUBLIC_TORUS_SERVER_URL=http://localhost:8787

# Already deployed on Arc Testnet; override only if you deploy your own copy of
# ../contracts/src/ExampleCounter.sol.
# NEXT_PUBLIC_COUNTER_ADDRESS=0x7d2b774D9cdBB6f3c69AC7be97E633fA911b8e66

# Get an App ID at https://dashboard.privy.io — enable Arc Testnet (chain 5042002) as a
# supported/embedded-wallet chain, and enable embedded wallets under
# Wallet Infrastructure > Embedded Wallets. Needed because standard browser wallets (MetaMask)
# don't yet expose an RPC method for a dApp to request an EIP-7702 authorization signature.
NEXT_PUBLIC_PRIVY_APP_ID=

# A bundler that supports Arc Testnet + EIP-7702 (e.g. Pimlico: https://dashboard.pimlico.io).
# Torus's own server does not run a bundler — only the paymaster half.
NEXT_PUBLIC_BUNDLER_URL=https://api.pimlico.io/v2/5042002/rpc?apikey=YOUR_KEY
