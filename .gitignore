# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Foundry (contracts/, examples/gasless-demo/contracts/) ---
contracts/out/
contracts/cache/
contracts/broadcast/*/dry-run/
examples/gasless-demo/contracts/out/
examples/gasless-demo/contracts/cache/
examples/gasless-demo/contracts/broadcast/*/dry-run/
# contracts/deployments/<chainId>.json is the canonical, committed record of deployed
# addresses (written by script/Deploy.s.sol, read by server/src/env.ts) — public addresses,
# not secrets, so it is intentionally NOT ignored.

# --- Bun / Node (server/) ---
server/node_modules/
server/dist/
# Regenerable indexer cache (server/src/indexer.ts) — rebuilt from chain events on next boot.
# One file per chain id (testnet/mainnet instances run side by side from this same checkout).
server/.indexer-state.*.json

# --- Misc ---
.DS_Store
*.log
