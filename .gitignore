# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Foundry (contracts/, examples/gasless-demo/contracts/) ---
contracts/out/
contracts/cache/
contracts/broadcast/*/dry-run/
examples/gasless-demo/contracts/out/
examples/gasless-demo/contracts/cache/
